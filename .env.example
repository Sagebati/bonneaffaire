# Copy to .env next to compose.yaml and fill in. All values are optional except the tunnel token.
# Restart the Container Manager project after editing; no image rebuild is needed.

# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels > your tunnel > Docker install command).
CLOUDFLARE_TUNNEL_TOKEN=

# Providers to switch off, comma-separated, e.g. vinted,ebay
BONNEAFFAIRE_DISABLED_PROVIDERS=

# Seconds each Provider gets to answer one Search (default 20).
BONNEAFFAIRE_TIMEOUT_SECONDS=20

# Listings per Provider when a Search names no limit (default 50).
BONNEAFFAIRE_DEFAULT_LIMIT=50

# Requests per minute to each Provider (default 20) and per-Provider overrides.
BONNEAFFAIRE_RATE_PER_MINUTE=20
BONNEAFFAIRE_PROVIDER_RATES=

# Seconds an identical Search is answered from cache (default 120; 0 disables).
BONNEAFFAIRE_CACHE_SECONDS=120

# Seconds a blocked Provider is left alone before being asked again (default 600).
BONNEAFFAIRE_BACKOFF_SECONDS=600

# eBay Browse API credentials (placeholders: the eBay Provider ticket finalises these names).
BONNEAFFAIRE_EBAY_CLIENT_ID=
BONNEAFFAIRE_EBAY_CLIENT_SECRET=
